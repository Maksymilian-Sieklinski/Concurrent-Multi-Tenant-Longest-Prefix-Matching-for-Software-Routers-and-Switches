Checks: >
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  -readability-braces-around-statements,
  -readability-identifier-length,
  -bugprone-easily-swappable-parameters,
  -readability-implicit-bool-conversion,
  -readability-function-cognitive-complexity,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access

# Naming convention from CLAUDE.md. The prefix is stripped before the case is checked, so
# `myNode` is prefix `my` + CamelCase `Node`. ParameterPrefix takes one literal, so `an`
# parameters are accepted by the ignore regexp instead.
CheckOptions:
  readability-identifier-naming.LocalVariablePrefix: my
  readability-identifier-naming.LocalVariableCase: CamelCase
  readability-identifier-naming.MemberPrefix: the
  readability-identifier-naming.MemberCase: CamelCase
  readability-identifier-naming.ParameterPrefix: a
  readability-identifier-naming.ParameterCase: CamelCase
  readability-identifier-naming.ParameterIgnoredRegexp: '^an[A-Z][a-zA-Z0-9]*$'
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.NamespaceCase: lower_case
